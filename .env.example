# OPENROUTER_API_KEY: Required for OpenRouter Dual-Brain AI Gateway (deepseek/deepseek-v4.1-flash-1017 & anthropic/claude-sonnet-5.5).
# Configure this secret in the AI Studio Secrets panel or server environment.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# GEMINI_API_KEY: Injected at runtime by AI Studio. Used when the explicit fallback gateway is enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

